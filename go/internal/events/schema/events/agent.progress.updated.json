{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://erp-town.local/schema/events/agent.progress.updated.json",
  "title": "agent.progress.updated data",
  "description": "Coarse AI-only metadata; no prompts, human activity or ERP financial facts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["agent_key", "successful_runs"],
  "properties": {
    "agent_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
    },
    "successful_runs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  }
}
