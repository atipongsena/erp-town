{
  "name": "erp-town",
  "version": "0.0.0",
  "private": true,
  "description": "ERP Town monorepo root (pnpm workspace)",
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "pnpm -r test && pnpm erp:test",
    "test:integration": "vitest run -c tests/integration/vitest.config.ts",
    "test:e2e": "playwright test",
    "schema:gen": "node packages/event-schema/scripts/gen.mjs",
    "erp:up": "node scripts/erp.mjs up",
    "erp:down": "node scripts/erp.mjs down",
    "erp:logs": "node scripts/erp.mjs logs",
    "erp:shell": "node scripts/erp.mjs shell",
    "erp:bench": "node scripts/erp.mjs bench",
    "erp:test": "node scripts/erp.mjs test",
    "erp:seed": "node scripts/erp.mjs seed",
    "erp:scenario": "node scripts/erp.mjs scenario",
    "erp:pilot:build": "node scripts/erp.mjs pilot:build",
    "erp:pilot:up": "node scripts/erp.mjs pilot:up",
    "erp:pilot:down": "node scripts/erp.mjs pilot:down",
    "erp:pilot:bench": "node scripts/erp.mjs pilot:bench",
    "erp:pilot:backup": "node scripts/erp.mjs pilot:backup"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@erp-town/event-schema": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "ioredis": "^6.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
