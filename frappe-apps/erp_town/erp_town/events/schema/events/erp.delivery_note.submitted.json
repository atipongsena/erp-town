{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://erp-town.local/schema/events/erp.delivery_note.submitted.json",
  "title": "erp.delivery_note.submitted data",
  "description": "A Delivery Note was submitted.",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "party", "item_count", "warehouse", "against"],
  "properties": {
    "status": {
      "type": "string",
      "minLength": 1,
      "description": "Document status after the action (ERPNext status field)."
    },
    "party": {
      "type": "string",
      "minLength": 1,
      "description": "Party (customer) code, never a display name."
    },
    "item_count": {
      "type": "integer",
      "minimum": 1
    },
    "warehouse": {
      "type": "string",
      "minLength": 1,
      "description": "Source warehouse name."
    },
    "against": {
      "description": "Sales Order names this Delivery Note was made against.",
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
