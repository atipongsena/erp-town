# ERP Town dev stack settings. `pnpm erp:up` copies this file to infra/docker/.env (git-ignored)
# when that file is missing; edit .env, never commit it.
#
# DEV-ONLY DEFAULTS: these passwords are for a local stack bound to 127.0.0.1. Do not reuse them
# for any shared, pilot or production environment.

# MariaDB root password (also used by `bench new-site`).
DB_ROOT_PASSWORD=admin
# Desk password of the Administrator user on town.localhost and test.localhost.
ADMIN_PASSWORD=admin
# Redis Streams instance of the town layer, as seen from inside the bench container
# (written to both sites as site config key `town_redis_url`).
REDIS_TOWN_URL=redis://redis-town:6379/0
