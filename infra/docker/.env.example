# ERP Town dev stack settings. `pnpm erp:up` copies this file to infra/docker/.env (git-ignored)
# when that file is missing; edit .env, never commit it.
#
# DEV-ONLY DEFAULTS: these passwords are for a local stack bound to 127.0.0.1. Do not reuse them
# for any shared, pilot or production environment.

# MariaDB root password (also used by `bench new-site`).
DB_ROOT_PASSWORD=admin
# Desk password of the Administrator user on town.localhost and test.localhost.
ADMIN_PASSWORD=admin
# Redis Streams instance of the town layer, as seen from inside the bench container
# (written to both sites as site config key `town_redis_url`).
REDIS_TOWN_URL=redis://redis-town:6379/0

# PostgreSQL password of the Go town layer (user `town`, 127.0.0.1:5433). DEV ONLY default.
TOWN_PG_PASSWORD=town
# Go gateway JWT signing key: standard base64 of a 32-byte Ed25519 seed, required by the `gateway`
# role. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# (`pnpm dev:town` loads this file through go/.air.toml `env_files`.)
TOWN_JWT_PRIVATE_KEY=

# Password of the seeded staff users (sales@, stock@, accounts@, approver@acme-th.test) created by
# `pnpm erp:seed`; empty = `town-dev-123`. Read when a user is first created. DEV ONLY.
SEED_USER_PASSWORD=
# Agent API credentials printed once by the first `pnpm erp:seed` on town.localhost (generated only when
# the agent user has none). Paste the printed lines here; never commit real values.
TOWN_AGENT_SALES_ASSISTANT_API_KEY=
TOWN_AGENT_SALES_ASSISTANT_API_SECRET=
TOWN_AGENT_AR_COLLECTOR_API_KEY=
TOWN_AGENT_AR_COLLECTOR_API_SECRET=

# --- pilot profile (`pnpm erp:pilot:build` / `erp:pilot:up` / `erp:pilot:backup`) -----------------
# Set real values only in infra/docker/.env on the pilot host, never here. Restore drill and the
# pre-pilot checklist: infra/docker/pilot/RESTORE.md.
#
# Site of the pilot bench; also the host name Caddy serves and gets a certificate for (a public DNS
# name -> Let's Encrypt; *.localhost -> Caddy's internal CA, for a rehearsal on a dev machine).
SITE_NAME=pilot.localhost
# ACME account e-mail for Let's Encrypt (required by pilot:up).
LETSENCRYPT_EMAIL=
# Desk password of Administrator on the pilot site (required by pilot:up; not the dev default).
PILOT_ADMIN_PASSWORD=
# Address Caddy publishes 80/443 on: 127.0.0.1 for a rehearsal next to the dev stack, 0.0.0.0 on the
# pilot host.
PILOT_BIND_ADDRESS=127.0.0.1
# Redis Streams URL of the pilot site (`town_redis_url`); DB 1 keeps it apart from the dev stream.
PILOT_REDIS_TOWN_URL=redis://redis-town:6379/1
# S3-compatible backup target of `backup.sh` (daily at BACKUP_TIME_UTC, kept 14 days remotely).
# BACKUP_S3_ENDPOINT is the endpoint URL as seen from the pilot containers, e.g.
# https://s3.ap-southeast-1.amazonaws.com or, for the drill, http://erp-town-seaweedfs:8333.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# Optional: BACKUP_S3_REGION (us-east-1), BACKUP_TIME_UTC (19:00 = 02:00 Asia/Bangkok).
